# Copy to .env.local for a LOCAL run against a real Solace broker.
# (GitHub Pages uses VITE_LOOPBACK=1 instead — see CI workflow.)
#
# Solace WebSocket SMF endpoint exposed by the local broker (docker-compose.solace.yml).
VITE_SOLACE_HOST=ws://localhost:8008
VITE_SOLACE_VPN=default
VITE_SOLACE_USERNAME=haribot
VITE_SOLACE_PASSWORD=haribot

# Serve from root when running locally (Pages uses /Solace-CandyFactory-UNS/).
VITE_BASE=/
