# Solace PubSub+ Broker (local Docker)
SOLACE_HOST=ws://localhost:8008
SOLACE_VPN=default
SOLACE_USERNAME=haribot
SOLACE_PASSWORD=haribot

# Backend
BACKEND_PORT=3003

# Robot Arm
ARM_MODE=simulated
# Set ARM_MODE=real and ARM_SERIAL_PORT to use physical SO-101:
# ARM_MODE=real
# ARM_SERIAL_PORT=/dev/tty.usbmodem5B3D0457761
# ARM_ID=so101

# MQTT (for arm-bridge Python process)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=haribot
MQTT_PASSWORD=haribot

# LLM (for SAM agents - set in agents/.env)
# OPENAI_API_KEY=sk-...
